direction: down
vars: {d2-config: {pad: 16}}
expand: "Expand: conservar name\nAñadir display_name nullable"
new: "v2 escribe ambas columnas"
back: "Restaurar image v1\nMantener esquema expandido"
verify: "v1 lee datos de v2\nY admite una escritura nueva"
contract: "Eliminar name rompe v1\nEnsayo SQL revertido"
expand -> new -> back -> verify -> contract

direction: down
order: "Orden total\nFecha DESC, ID DESC"
first: "Primera página\nÚltima fecha e ID"
offset: "OFFSET\nPosición actual"
cursor: "Keyset\nFecha e ID del cursor"
next: "Leer tamaño más uno\nEntregar solo tamaño\nCursor: última entregada"
order -> first
first -> offset
first -> cursor
cursor -> next

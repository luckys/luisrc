direction: down
vars: {d2-config: {pad: 16}}
n0: "Inicialización de fixture\nRetardo de 8000ms"
n1: "Startup aún falla\nOtras probes esperan"
n2: "Startup responde 200\nActivar readiness/liveness"
n3: "Sin startup: otro Pod reinicia\nMismo retardo, protección ausente"
n0 -> n1: "margen propio de arranque"
n1 -> n2: "inicialización completada"
n2 -> n3: "comparación negativa separada"

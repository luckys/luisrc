direction: down
vars: {d2-config: {pad: 16}}
n0: "Request CPU imposible\nScheduler no encuentra sitio"
n1: "Pod Pending\nInsufficient cpu"
n2: "Otro Pod: limit64Mi\nIntenta tocar buffer256Mi"
n3: "Terminación OOMKilled\nRazón observada en Kubernetes"
n0 -> n1: "sin asignación a nodo"
n1 -> n2: "experimento independiente"
n2 -> n3: "fallo durante ejecución"

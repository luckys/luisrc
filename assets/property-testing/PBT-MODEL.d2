direction: down
vars: {d2-config: {pad: 16}}
events: "Secuencia de eventos\nsubmit / confirm / decline"
spec: "Tabla de especificación\nEstado y capturas esperadas"
real: "Payment independiente\nEstado y contador observados"
compare: "Comparar después de cada evento\nTambién acciones sin efecto"
limit: "Una operación en memoria\nSin proveedor o ledger real"
events -> spec -> real -> compare -> limit

direction: down
vars: {d2-config: {pad: 16}}
user: "Cliente de internet"
alb: "ALB público\nSubnets de dos AZ"
task: "Task privada\nSin IP pública ni NAT"
endpoints: "Interfaces: ECR api/dkr y logs\nGateway: S3 y DynamoDB"
verify: "Verificar DNS, rutas y grupos\nTambién IAM"
user -> alb: "entrada"
alb -> task: "tráfico de API"
task -> endpoints: "arranque y dependencias"
endpoints -> verify: "diseño, no conexión probada"

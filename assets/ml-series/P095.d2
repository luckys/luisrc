direction: down
**.style.font-size: 24
inputs: "CSV + protocolo versionados\nhashes, código y entorno"
explore: "Train y validation\ncomparar, ablation y error analysis"
freeze: "Referencias finales predefinidas\nconstante, logística y bosque"
test: "Mismo test de 180 envíos\nevaluación sin elegir después"
record: "Registrar métricas y predicciones\nlímites y siguiente hipótesis"
inputs -> explore -> freeze -> test -> record

direction: down
**.style.font-size: 24
x: "Features conocidas al decidir"
linear: "Combinación lineal\nz = intercept + suma de coeficientes × entradas"
regression: "Regresión: salida numérica\nentrenar con MSE"
sigmoid: "Clasificación: sigmoid(z)\nentrenar con log loss"
threshold: "Probabilidad estimada\numbral aplicado después"
x -> linear
linear -> regression
linear -> sigmoid -> threshold

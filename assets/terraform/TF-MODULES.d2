direction: down
vars: {d2-config: {pad: 16}}
n0: "Root module\nNamespace e inputs"
n1: "Módulo catalogue\nEntradas validadas"
n2: "Recursos del servicio\nDentro del mismo state"
n3: "Outputs del módulo\nResultados para consumidores"
n0 -> n1: "referencias y dependencias"
n1 -> n2: "agrupar una decisión"
n2 -> n3: "exponer lo necesario"

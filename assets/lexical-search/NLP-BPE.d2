direction: down
vars: { d2-config: { theme-id: 200 } }
n0: "Corpus de palabras con counts\nbajo 5; bajos 2; baja 3; caja 2" { style.font-size: 20 }
n1: "Contar pares adyacentes\na + j aparece 12 veces" { style.font-size: 20 }
n2: "Aprender cinco merges\nGuardar orden y desempates" { style.font-size: 20 }
n3: "Aplicar a una palabra nueva\ncajo produce c, aj, o" { style.font-size: 20 }
n4: "Vocabulario y token IDs\nEl modelo exige su tokenizer" { style.font-size: 20 }
n0 -> n1
n1 -> n2
n2 -> n3
n3 -> n4

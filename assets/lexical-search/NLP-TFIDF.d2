direction: down
vars: { d2-config: { theme-id: 200 } }
n0: "Tokens del documento\nCounts por término" { style.font-size: 20 }
n1: "DF en los 20 documentos\nUna vez por documento" { style.font-size: 20 }
n2: "IDF suavizado\nlog((N+1)/(DF+1)) + 1" { style.font-size: 20 }
n3: "Vector TF por IDF\nNormalización L2" { style.font-size: 20 }
n4: "Cosine con la consulta\nRanking, no confianza" { style.font-size: 20 }
n0 -> n1
n1 -> n2
n2 -> n3
n3 -> n4

direction: down
**.style.font-size: 24
request: "Scope + key\nidentidad de intención"
record: "Registro único persistido"
same: "Fingerprint igual\nrecuperar o consultar resultado"
different: "Fingerprint distinto\nconflicto definido"
provider: "Referencia estable externa\ncontrato propio del proveedor"
request -> record
record -> same -> provider
record -> different

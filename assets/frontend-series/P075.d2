direction: down
**.style.font-size: 24
permission: "getUserMedia\npermiso y stream local"
signal: "Señalización\nSDP offer / answer"
ice: "ICE selecciona ruta\nhost / STUN / TURN"
media: "Audio entre peer connections\npaquetes, jitter y buffering"

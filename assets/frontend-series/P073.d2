direction: down
**.style.font-size: 24
last: "Cliente aplicó secuencia 7"
gap: "Conexión perdida\nservidor publica 8, 9, 10"
resume: "Reconectar desde 7"
replay: "Historia disponible\nreplay 8, 9, 10"
reset: "Historia caducada\nsnapshot + secuencia actual"
last -> gap -> resume
resume -> replay
resume -> reset

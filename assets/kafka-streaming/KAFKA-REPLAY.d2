direction: down
vars: {d2-config: {pad: 16}}
read: "Leer offset 0"
apply: "Validar y aplicar evento\nRead model en memoria"
commit: "Confirmar offset 1\nSiguiente posición del grupo"
new: "Reconstrucción independiente\nGrupo nuevo, proyección vacía"
replay: "Releer historia retenida completa\nDos envíos en delivered"
read -> apply -> commit -> new -> replay

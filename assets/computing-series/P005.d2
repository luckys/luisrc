direction: down
**.style.font-size: 24
url: "URL\nesquema + nombre + puerto + ruta"
dns: "Resolver DNS\nnombre → dirección"
route: "Routing\nseleccionar siguiente salto"
nat: "Si existe NAT\ntraducir dirección y puerto"
lb: "Endpoint público o balanceador\nseleccionar destino"
app: "Servicio de aplicación\nprocesar recurso solicitado"
url -> dns -> route -> nat -> lb -> app

direction: down
vars: {d2-config: {pad: 16}}
red: "Red: test de estado terminal\nLa versión que acepta fail falla"
green: "Green: regla mínima\nRepetir succeed, rechazar el resto"
cases: "Más ejemplos de producto\nqueued / running / terminales"
table: "Tabla de transiciones\nTests independientes siguen pasando"
refactor: "Refactor: separar reglas y Job\nConservar estado y versión observables"
red -> green -> cases -> table -> refactor

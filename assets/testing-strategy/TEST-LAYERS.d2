direction: down
vars: {d2-config: {pad: 16}}
unit: "Unit: transition y apply\nSin red ni base de datos"
repository: "Integración del adaptador\nSQLite real, archivo reabierto"
http: "Integración del componente API\nfetch → HTTP → execute → SQLite"
outside: "Fuera del recorrido probado\nUI / identidad / worker / despliegue"
e2e: "E2E futuro del producto\nDefinir primero sus extremos reales"
unit -> repository -> http -> outside -> e2e

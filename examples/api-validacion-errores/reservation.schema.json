{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "quantity", "expectedVersion", "priority"],
  "properties": {
    "sku": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,23}$" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
    "expectedVersion": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "priority": { "type": "string", "enum": ["standard", "express"] },
    "note": { "type": "string", "maxLength": 80 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "priority": { "const": "express" } },
        "required": ["priority"]
      },
      "then": { "properties": { "quantity": { "type": "integer", "maximum": 5 } } }
    }
  ]
}

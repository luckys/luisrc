{
  "openapi": "3.1.1",
  "info": {
    "title": "Pedidos: contrato local didáctico",
    "version": "1.0.0",
    "description": "No desplegar. Sin autenticación ni durabilidad. PUT solo actualiza. PATCH propio, no JSON Merge Patch completo."
  },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "description": "Máximo 4096 bytes. Validación manual del subconjunto del laboratorio.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resultado del contrato local",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI relativa del pedido creado",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON malformado; 404 ausente; 405 método no permitido (Allow); 413 cuerpo excesivo; 415 tipo; 422 campos; 500 inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getOrder",
        "responses": {
          "200": {
            "description": "Resultado del contrato local",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON malformado; 404 ausente; 405 método no permitido (Allow); 413 cuerpo excesivo; 415 tipo; 422 campos; 500 inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceOrder",
        "description": "Sustituye todos los campos editables; omitir label lo elimina. No crea recursos.",
        "requestBody": {
          "required": true,
          "description": "Máximo 4096 bytes. Validación manual del subconjunto del laboratorio.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del contrato local",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON malformado; 404 ausente; 405 método no permitido (Allow); 413 cuerpo excesivo; 415 tipo; 422 campos; 500 inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchOrder",
        "description": "Solo label. Ausente conserva; null elimina. Una asignación repetida es idempotente.",
        "requestBody": {
          "required": true,
          "description": "Máximo 4096 bytes. Validación manual del subconjunto del laboratorio.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del contrato local",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON malformado; 404 ausente; 405 método no permitido (Allow); 413 cuerpo excesivo; 415 tipo; 422 campos; 500 inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "responses": {
          "204": {
            "description": "Eliminado, sin cuerpo"
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON malformado; 404 ausente; 405 método no permitido (Allow); 413 cuerpo excesivo; 415 tipo; 422 campos; 500 inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amountMinor", "currency"],
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "currency": {
            "type": "string",
            "enum": ["EUR", "USD"]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "amountMinor", "currency"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^o[0-9]+$"
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "currency": {
            "type": "string",
            "enum": ["EUR", "USD"]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "LabelPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": ["string", "null"],
            "maxLength": 80
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          }
        }
      }
    }
  }
}

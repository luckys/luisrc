{
  "openapi": "3.1.1",
  "info": { "title": "Pedidos ficticios: transición v1/v2", "version": "1.0.0" },
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "listOrdersV1",
        "deprecated": true,
        "parameters": [
          { "$ref": "#/components/parameters/Size" },
          { "$ref": "#/components/parameters/Status" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": {
            "description": "Página v1, importe en unidades menores EUR. label es aditivo y opcional.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PageV1" } }
            },
            "headers": {
              "Deprecation": {
                "description": "Structured Field Date RFC 9745",
                "schema": { "type": "string" }
              },
              "Sunset": {
                "description": "HTTP-date ficticio de retirada prevista; no hay apagado automático",
                "schema": { "type": "string" }
              },
              "Link": {
                "description": "Guía local de migración",
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Invalid" },
          "500": { "$ref": "#/components/responses/Unexpected" }
        }
      }
    },
    "/v2/orders": {
      "get": {
        "operationId": "listOrdersV2",
        "parameters": [
          { "$ref": "#/components/parameters/Size" },
          { "$ref": "#/components/parameters/Status" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": {
            "description": "Página v2, money.minorUnits mantiene unidades menores EUR",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PageV2" } }
            }
          },
          "400": { "$ref": "#/components/responses/Invalid" },
          "500": { "$ref": "#/components/responses/Unexpected" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Size": {
        "name": "pageSize",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
      },
      "Status": {
        "name": "status",
        "in": "query",
        "schema": { "type": "string", "enum": ["paid", "pending"], "default": "paid" }
      },
      "After": {
        "name": "after",
        "in": "query",
        "description": "Cursor opaco firmado, ligado a versión, tenant ficticio y status; caduca en una hora. No otorga autorización.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "responses": {
      "Invalid": {
        "description": "Query/cursor inválido",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Unexpected": {
        "description": "Error interno sin mensaje de causa",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "schemas": {
      "OrderV1": {
        "type": "object",
        "required": ["id", "createdAt", "status", "amountMinor", "currency"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "createdAt": { "type": "string" },
          "status": { "type": "string", "enum": ["paid", "pending"] },
          "amountMinor": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "const": "EUR" },
          "label": { "type": "string" }
        }
      },
      "OrderV2": {
        "type": "object",
        "required": ["id", "createdAt", "status", "money"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "createdAt": { "type": "string" },
          "status": { "type": "string", "enum": ["paid", "pending"] },
          "money": {
            "type": "object",
            "required": ["minorUnits", "currency"],
            "properties": {
              "minorUnits": { "type": "integer", "minimum": 1 },
              "currency": { "type": "string", "const": "EUR" }
            }
          }
        }
      },
      "PageV1": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/OrderV1" }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
        }
      },
      "PageV2": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/OrderV2" }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "const": "about:blank", "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer", "enum": [400, 500] }
        }
      }
    }
  }
}

---
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts, SeriesGroup } from '~/utils'
import { getCollection, render } from 'astro:content'
import PostPreview from '~/components/PostPreview.astro'
import Pagination from '~/components/Pagination.astro'
import BlockHeader from '~/components/BlockHeader.astro'
import HomeBanner from '~/components/HomeBanner.astro'
import TagsSection from '~/components/TagsSection.astro'
import SeriesSection from '~/components/SeriesSection.astro'
import { getLocale, getUi } from '~/i18n/ui'
import { getRelativeLocaleUrl } from 'astro:i18n'

const locale = getLocale(Astro.currentLocale)
const copy = getUi(locale)
const home = await getCollection('home', ({ data }) => data.locale === locale)
let HomeContent
let homeAvatarImage
let homeGithubCalendar
if (home.length > 0) {
  const homeEntry = home[0]
  const { Content } = await render(homeEntry)
  HomeContent = Content
  homeAvatarImage = homeEntry.data.avatarImage
  homeGithubCalendar = homeEntry.data.githubCalendar
}
const sortedPosts = await getSortedPosts(locale)
const postsHaveTags = sortedPosts.some(
  (post) => post.data.tags && post.data.tags.length > 0,
)
const seriesGroup = await SeriesGroup.build(sortedPosts, locale)
const postsHaveSeries = seriesGroup.collations.some((series) => series.entries.length > 1)
---

<Layout title={copy.homeTitle} hasSidebar={postsHaveSeries || postsHaveTags}>
  {
    HomeContent && (
      <HomeBanner
        avatarImage={homeAvatarImage}
        githubCalendar={homeGithubCalendar}
        locale={locale}
      >
        <HomeContent />
      </HomeBanner>
    )
  }
  <div
    class:list={[
      'grid gap-x-8 lg:gap-x-12',
      {
        'md:grid-cols-[minmax(0,1fr)_minmax(0,14rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,18rem)]':
          postsHaveSeries || postsHaveTags,
      },
    ]}
  >
    {
      (postsHaveSeries || postsHaveTags) && (
        <aside class="min-w-0 md:col-start-2 md:row-start-1">
          {postsHaveSeries && (
            <section>
              <BlockHeader>{copy.series}</BlockHeader>
              <SeriesSection posts={sortedPosts} locale={locale} />
            </section>
          )}
          {postsHaveTags && (
            <section>
              <BlockHeader>{copy.tags}</BlockHeader>
              <TagsSection posts={sortedPosts} locale={locale} />
            </section>
          )}
        </aside>
      )
    }
    {
      sortedPosts.length > 0 && (
        <section class="min-w-0 md:col-start-1 md:row-start-1">
          <BlockHeader>{copy.latestPosts}</BlockHeader>
          {sortedPosts
            .slice()
            .reverse()
            .slice(0, 5)
            .map((post) => (
              <PostPreview post={post} />
            ))}
          <Pagination
            nextLink={getRelativeLocaleUrl(locale, 'posts')}
            nextText={copy.readMore}
          />
        </section>
      )
    }
  </div>
</Layout>

<style is:global>
  a.heading-anchor {
    display: none !important;
  }
</style>

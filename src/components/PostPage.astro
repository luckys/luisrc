---
import Layout from '~/layouts/Layout.astro'
import { SeriesGroup, TagsGroup, getPostSlug, getSortedPosts, getPostUrl } from '~/utils'
import PostPreview from '~/components/PostPreview.astro'
import DividerText from '~/components/DividerText.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import PostAddendum from '~/components/PostAddendum.astro'
import TableOfContents from '~/components/TableOfContents.astro'
import { Image } from 'astro:assets'
import GiscusLoader from '~/components/GiscusLoader.astro'
import siteConfig from '~/site.config'
import Tags from '~/components/Tags.astro'
import PostInfo from '~/components/PostInfo.astro'
import ScrollUpButton from '~/components/ScrollUpButton.astro'
import type { Collation } from '~/types'
import ChevronsRight from '~/icons/chevrons-right.svg'
import { getPostSequenceContext } from '~/utils'
import { getUi, type Locale } from '~/i18n/ui'

interface Props {
  post: CollectionEntry<'posts'>
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  localeSwitchUrl: string
  socialCardSlug?: string
}

const { post, prev, next, localeSwitchUrl, socialCardSlug } = Astro.props
const postData = post.data
const locale = postData.locale as Locale
const copy = getUi(locale)
const { headings, Content: PostContent } = await render(post)
const addenda = await getCollection('addendum', ({ data }) => data.locale === locale)
let AddendumContent
let addendumAvatarImage
if (addenda.length > 0) {
  const { Content } = await render(addenda[0])
  AddendumContent = Content
  addendumAvatarImage = addenda[0].data.avatarImage
}

const sortedPosts = await getSortedPosts(locale)
let series: Collation<'posts'> | undefined
let nextPostInSeries: CollectionEntry<'posts'> | undefined
if (postData.series) {
  const seriesGroup = await SeriesGroup.build(sortedPosts, locale)
  series = seriesGroup.match(postData.series)
  if (!series) {
    throw new Error(`Series "${postData.series}" not found`)
  }
  nextPostInSeries = getPostSequenceContext(post, series.entries).next
}
const showSeries = series && series.entries.length > 1
const showTableOfContents =
  postData.toc && headings.some(({ depth }) => depth >= 2 && depth <= 3)

let tags: Collation<'posts'>[] | undefined
if (postData.tags && postData.tags.length > 0) {
  const tagsGroup = await TagsGroup.build(sortedPosts, locale)
  tags = tagsGroup.matchMany(postData.tags)
}
---

<Layout
  title={postData.title}
  description={postData.description}
  author={postData.author}
  tags={postData.tags}
  localeSwitchUrl={localeSwitchUrl}
  publishedDate={postData.published}
  needsMath={postData.math}
  socialCardSlug={socialCardSlug}
  hasSidebar={showTableOfContents}
>
  <article class="max-w-full py-7.5" data-pagefind-body>
    {
      postData.coverImage && (
        <figure class="mb-5">
          <Image
            priority
            layout="constrained"
            src={postData.coverImage.src}
            alt={postData.coverImage.alt}
            width={postData.coverImage.src.width}
            height={postData.coverImage.src.height}
            format="svg"
            class="w-full rounded-xl"
          />
        </figure>
      )
    }
    <div class="md:mx-2">
      <h1 id={getPostSlug(post)} class="mb-4 text-[1.75rem] text-heading1 font-semibold">
        # {postData.title}
      </h1>
      <div class="my-2 border-l-2 border-accent/80 pl-4 py-2">
        <PostInfo post={post} class="mb-1" />
        {
          tags && (
            <div class="mt-4">
              <Tags tags={tags} />
            </div>
          )
        }
      </div>
    </div>
    <div class="flex flex-col xl:gap-8 xl:flex-row xl:items-start">
      {showTableOfContents && <TableOfContents headings={headings} />}
      <div class="mb-5 min-w-0 flex-1 prose">
        <PostContent />
      </div>
    </div>
  </article>
  {
    nextPostInSeries && (
      <a
        href={getPostUrl(nextPostInSeries)}
        class="button justify-center -mt-8 mb-8 !whitespace-normal text-center flex gap-2 sm:gap-3 items-center"
      >
        <span>
          {copy.nextInSeries} {nextPostInSeries.data.title}
        </span>
        <ChevronsRight class="size-5 hidden sm:block" />
      </a>
    )
  }
  {
    AddendumContent && (
      <PostAddendum avatarImage={addendumAvatarImage}>
        <AddendumContent />
      </PostAddendum>
    )
  }
  {
    showSeries && series ? (
      <section>
        <DividerText text={`${series.title} · ${copy.series}`} />
        {series.entries.map((seriesPost) => (
          <PostPreview post={seriesPost} />
        ))}
      </section>
    ) : prev || next ? (
      <section>
        <DividerText text={copy.morePosts} />
        {prev && <PostPreview post={prev} />}
        {next && <PostPreview post={next} />}
      </section>
    ) : null
  }
  {
    siteConfig.giscus && (
      <section>
        <DividerText text={copy.comments} />
        <GiscusLoader lang={locale} />
      </section>
    )
  }
  <ScrollUpButton />
</Layout>
